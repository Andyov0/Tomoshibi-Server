# /etc/tomoshibi/watch.env on the control node. Owner root, mode 600.
#
# Read by dev/watch/watch.sh (installed as /usr/local/bin/tomoshibi-watch) and
# by the upgrade examples in this directory.

# A read-only administrator: an entry with no capabilities beyond observe.
# Make one with dev/roster (`roster <db> add <trip> watch observe`) and give it
# to nothing else.
WATCH_NAME=watch
WATCH_PASSPHRASE=<passphrase of that administrator>

# Where alerts are posted: the alert forwarder on the machine that holds the
# bot token, on a private network only.
SAY=http://10.0.0.20:49771/say

# Shared with the alert forwarder (its WORD). Keeps a stray request on the
# private network from becoming a message.
WORD=<a random word, for example from openssl rand -hex 16>

# NOT read from this file: AT, the control node's own base URL. Set it in the
# cron line (see watch.cron).
